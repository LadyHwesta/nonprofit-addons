<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <!-- What performers and event staff are billed as. -->
    <record id="product_performer_fee" model="product.product">
        <field name="name">Performer Fee</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="True"/>
        <field name="list_price">0</field>
        <field name="standard_price">0</field>
    </record>
    <record id="product_event_staff" model="product.product">
        <field name="name">Event Staff Hours</field>
        <field name="type">service</field>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="True"/>
        <field name="list_price">0</field>
        <field name="standard_price">0</field>
    </record>
</odoo>
