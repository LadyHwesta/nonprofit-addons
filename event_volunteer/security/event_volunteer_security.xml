<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- A dedicated Volunteers privilege/tier, separate from the blanket
         event.group_event_user/manager every event-domain module used to
         share - so a role can be scoped to "manages volunteers" without
         also getting venue/logistics/parade/entertainment management.
         Manager implies User implies Viewer, same chain OCA's own
         donation module uses. -->
    <record id="res_groups_privilege_volunteers" model="res.groups.privilege">
        <field name="name">Volunteers</field>
        <field name="category_id" ref="base.module_category_marketing" />
    </record>
    <record id="group_volunteer_viewer" model="res.groups">
        <field name="name">Volunteer Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_volunteers" />
    </record>
    <record id="group_volunteer_user" model="res.groups">
        <field name="name">Volunteer User</field>
        <field name="privilege_id" ref="res_groups_privilege_volunteers" />
        <field name="implied_ids" eval="[(4, ref('group_volunteer_viewer'))]" />
    </record>
    <record id="group_volunteer_manager" model="res.groups">
        <field name="name">Volunteer Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_volunteers" />
        <field name="implied_ids" eval="[(4, ref('group_volunteer_user'))]" />
    </record>

    <record id="event_volunteer_assignment_portal_rule" model="ir.rule">
        <field name="name">Volunteer assignment: portal user sees only their own</field>
        <field name="model_id" ref="model_event_volunteer_assignment" />
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]" />
        <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
