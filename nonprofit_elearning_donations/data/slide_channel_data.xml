<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="channel_donations" model="slide.channel">
        <field name="name">Processing Donations</field>
        <field name="channel_type">training</field>
        <field name="description" type="html">
            <p>Recording gifts of every kind, generating receipts, and
            pulling the donor lists that drive an appeal.</p>
        </field>
        <field name="visibility">members</field>
        <field name="enroll">invite</field>
        <field name="is_published" eval="True" />
        <field name="enroll_group_ids" eval="[(6, 0, [ref('donation.group_donation_user')])]" />
    </record>

    <!-- =================== Section 1: Recording a gift =================== -->
    <record id="section_recording" model="slide.slide">
        <field name="channel_id" ref="channel_donations" />
        <field name="name">Recording a gift</field>
        <field name="is_category" eval="True" />
        <field name="sequence">10</field>
    </record>

    <record id="lesson_cash_gift" model="slide.slide">
        <field name="channel_id" ref="channel_donations" />
        <field name="name">A cash or check donation</field>
        <field name="slide_category">article</field>
        <field name="sequence">11</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <ol class="oe-steps">
                    <li>
                        <p>Open <strong>Donation › Donations › Donations › New</strong>.</p>
                    </li>
                    <li>
                        <p>Choose the donor, the date, and the payment
                        method.</p>
                    </li>
                    <li>
                        <p>Add a line for what was given - the contribution
                        account is picked for you.</p>
                    </li>
                    <li>
                        <p>On that line, set <strong>Analytic
                        Distribution</strong> to the <em>Unrestricted</em>
                        fund for an ordinary gift.</p>
                    </li>
                    <li>
                        <p>Click <strong>Validate</strong>. The system posts
                        the journal entry and can produce a tax receipt for
                        the donor.</p>
                    </li>
                </ol>

                <div class="oe-callout">
                    <span class="oe-callout-icon"><i class="fa fa-info-circle" /></span>
                    <div>
                        <span class="oe-callout-label">No donation module installed at all?</span>
                        <p>Record it as a bank entry or customer invoice
                        against a Contributions account instead - the donor
                        reports and year-end statements still pick it up as
                        long as the account carries its contribution tag.</p>
                    </div>
                </div>
                <div class="oe-diagram">
                    <img src="/nonprofit_elearning_donations/static/img/donation_form.png" alt="A draft donation with donor, date and one line of 250 dollars" class="img-fluid" />
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Screenshot</span>
                        a draft donation before you click Validate.
                    </p>
                </div>
            </div>
        </field>
    </record>

    <record id="lesson_restricted_inkind" model="slide.slide">
        <field name="channel_id" ref="channel_donations" />
        <field name="name">A restricted gift, and an in-kind gift</field>
        <field name="slide_category">article</field>
        <field name="sequence">12</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <div class="oe-columns">
                    <div class="oe-column">
                        <h4><i class="fa fa-lock" /> Restricted gift</h4>
                        <p>Recorded the same way, but choose <em>Contributions
                        - With Donor Restrictions</em> as the account and set
                        the fund to <em>With Donor Restrictions - Purpose</em>
                        (or <em>- Time</em>).</p>
                        <p class="mb-0 text-muted">Note the restriction - what
                        it's for, or when it frees up - on the record, so
                        whoever releases it later knows the terms.</p>
                    </div>
                    <div class="oe-column">
                        <h4><i class="fa fa-gift" /> In-kind gift</h4>
                        <p>Goods or services rather than cash - recorded as a
                        journal entry: debit the asset or expense it
                        represents, credit In-Kind Contributions, at fair
                        value.</p>
                        <p class="mb-0 text-muted">Set the fund on both lines,
                        and keep the donor's description and how you valued
                        it with the entry.</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

    <!-- ============ Section 2: Receipts and fundraising events ============ -->
    <record id="section_events" model="slide.slide">
        <field name="channel_id" ref="channel_donations" />
        <field name="name">Receipts and fundraising events</field>
        <field name="is_category" eval="True" />
        <field name="sequence">20</field>
    </record>

    <record id="lesson_fundraising_event" model="slide.slide">
        <field name="channel_id" ref="channel_donations" />
        <field name="name">A fundraising event</field>
        <field name="slide_category">article</field>
        <field name="sequence">21</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <div class="oe-diagram">
                    <div class="oe-flow">
                        <div class="oe-flow-step">
                            <span class="oe-badge">$200 ticket</span>
                        </div>
                        <span class="oe-flow-arrow">-</span>
                        <div class="oe-flow-step">
                            <span class="oe-badge oe-badge-warn">$60 dinner value</span>
                        </div>
                        <span class="oe-flow-arrow">=</span>
                        <div class="oe-flow-step">
                            <span class="oe-badge oe-badge-good">$140 deductible</span>
                        </div>
                    </div>
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Illustration</span>
                        a quid pro quo gift - only the amount above the
                        benefit's value is deductible.
                    </p>
                </div>

                <p>Put ticket and sponsorship income to <em>Fundraising
                Events - Gross Revenue</em>. Put the cost of what donors
                received in return (the dinner, the band) to <em>Fundraising
                Events - Direct Benefit to Donor</em>. The Statement of
                Activities nets the two, which is what the 990 expects.</p>

                <div class="oe-callout">
                    <span class="oe-callout-icon"><i class="fa fa-ticket" /></span>
                    <div>
                        <span class="oe-callout-label">Quid pro quo</span>
                        <p>That split is also what makes a gala ticket a
                        <strong>quid pro quo</strong> gift: only the portion
                        above the benefit's value is deductible, and a
                        receipt for it has to say so.</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

    <!-- ==================== Section 3: Donor reporting ==================== -->
    <record id="section_reporting" model="slide.slide">
        <field name="channel_id" ref="channel_donations" />
        <field name="name">Donor reporting</field>
        <field name="is_category" eval="True" />
        <field name="sequence">30</field>
    </record>

    <record id="lesson_donor_analytics" model="slide.slide">
        <field name="channel_id" ref="channel_donations" />
        <field name="name">Donor analytics, LYBUNT &amp; SYBUNT</field>
        <field name="slide_category">article</field>
        <field name="sequence">31</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <p><strong>Invoicing › Non-Profit › Reports
                › Donor Analytics</strong> gives one row per donor:
                lifetime giving, this year, last year, and first/last/largest
                gift.</p>

                <div class="oe-columns">
                    <div class="oe-column">
                        <h4><span class="oe-badge oe-badge-warn">LYBUNT</span></h4>
                        <p class="mb-0">Gave <em>L</em>ast <em>Y</em>ear
                        <em>B</em>ut <em>U</em>nfortunately <em>N</em>ot
                        <em>T</em>his - build a lapsed-donor appeal from it.</p>
                    </div>
                    <div class="oe-column">
                        <h4><span class="oe-badge oe-badge-accent">SYBUNT</span></h4>
                        <p class="mb-0"><em>S</em>ome <em>Y</em>ear <em>B</em>ut
                        <em>U</em>nfortunately <em>N</em>ot <em>T</em>his - a
                        deeper reactivation list.</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

    <record id="lesson_year_end" model="slide.slide">
        <field name="channel_id" ref="channel_donations" />
        <field name="name">Year-end contribution statements</field>
        <field name="slide_category">article</field>
        <field name="sequence">32</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <ol class="oe-steps">
                    <li>
                        <p>Open <strong>Invoicing › Reporting ›
                        Non-Profit › Year-End Contribution
                        Statements</strong>.</p>
                    </li>
                    <li>
                        <p>Choose the year and a minimum total (defaults to
                        $250).</p>
                    </li>
                    <li>
                        <p>Leave the donor list blank to run it for
                        everyone.</p>
                    </li>
                    <li>
                        <p>Print.</p>
                    </li>
                </ol>

                <div class="oe-callout oe-callout-good">
                    <span class="oe-callout-icon"><i class="fa fa-file-pdf-o" /></span>
                    <div>
                        <span class="oe-callout-label">Ready to mail</span>
                        <p>Each donor gets one PDF listing every gift and the
                        total, with the IRS written-acknowledgement and
                        quid-pro-quo language already on it.</p>
                    </div>
                </div>
                <div class="oe-diagram">
                    <img src="/nonprofit_elearning_donations/static/img/yearend.png" alt="The Year-End Contribution Statements dialog with dates, donors and a 250 dollar minimum" class="img-fluid" />
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Screenshot</span>
                        the dialog this lesson describes.
                    </p>
                </div>
            </div>
        </field>
    </record>

    <!-- ========================= Quiz ========================= -->
    <record id="slide_quiz" model="slide.slide">
        <field name="channel_id" ref="channel_donations" />
        <field name="name">Check your understanding</field>
        <field name="slide_category">quiz</field>
        <field name="sequence">90</field>
    </record>

    <record id="quiz_q1" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">1</field>
        <field name="question">A donor gives office furniture instead of cash. How do you record it?</field>
    </record>
    <record id="quiz_q1_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">1</field>
        <field name="text_value">Don't record it - only cash gifts count</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q1_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">2</field>
        <field name="text_value">A journal entry at fair value, crediting In-Kind Contributions</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q1_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">3</field>
        <field name="text_value">As a vendor bill</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q1_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">4</field>
        <field name="text_value">As a restricted gift</field>
        <field name="is_correct" eval="False" />
    </record>

    <record id="quiz_q2" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">2</field>
        <field name="question">At a gala, a donor pays $200 for a ticket to a dinner worth $60. What's deductible?</field>
    </record>
    <record id="quiz_q2_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">1</field>
        <field name="text_value">The full $200</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q2_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">2</field>
        <field name="text_value">$140 - the amount above the dinner's value</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q2_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">3</field>
        <field name="text_value">Nothing - event tickets are never deductible</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q2_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">4</field>
        <field name="text_value">Only the $60</field>
        <field name="is_correct" eval="False" />
    </record>

    <record id="quiz_q3" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">3</field>
        <field name="question">Which list helps you build an appeal to donors who gave last year but not this year?</field>
    </record>
    <record id="quiz_q3_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">1</field>
        <field name="text_value">LYBUNT</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q3_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">2</field>
        <field name="text_value">The functional-expense grid</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q3_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">3</field>
        <field name="text_value">The net-asset roll-forward</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q3_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">4</field>
        <field name="text_value">The vendor bill list</field>
        <field name="is_correct" eval="False" />
    </record>

    <record id="quiz_q4" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">4</field>
        <field name="question">Where does a restricted gift's fund get set?</field>
    </record>
    <record id="quiz_q4_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">1</field>
        <field name="text_value">The same Analytic Distribution field used for any gift</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q4_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">2</field>
        <field name="text_value">It can't be set - restricted gifts are tracked on paper</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q4_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">3</field>
        <field name="text_value">The donor's contact record</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q4_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">4</field>
        <field name="text_value">The tax receipt template</field>
        <field name="is_correct" eval="False" />
    </record>

</odoo>
