<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="channel_finance" model="slide.channel">
        <field name="name">Fund Accounting for Treasurers</field>
        <field name="channel_type">training</field>
        <field name="description" type="html">
            <p>How to record money against the right fund, program, and
            function, and pull the board and IRS reports that build
            themselves from those answers.</p>
        </field>
        <field name="visibility">members</field>
        <field name="enroll">invite</field>
        <field name="is_published" eval="True" />
        <field name="enroll_group_ids" eval="[(6, 0, [ref('account.group_account_user')])]" />
    </record>

    <!-- ================= Section 1: Getting set up ================= -->
    <record id="section_setup" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">Getting set up</field>
        <field name="is_category" eval="True" />
        <field name="sequence">10</field>
    </record>

    <record id="lesson_setup_coa" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">Adding the non-profit chart of accounts</field>
        <field name="slide_category">article</field>
        <field name="sequence">11</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <p>On Community Edition, the accounting app is called <strong>Invoicing</strong>, so that's the name you'll see in these menus.</p>
                <p>Before anything else, turn on <strong>Analytic
                Accounting</strong> under Settings › Invoicing - this is
                what lets you tag a transaction with a fund, and everything
                below depends on it.</p>

                <ol class="oe-steps">
                    <li>
                        <p>Open <strong>Invoicing › Configuration ›
                        Add Non-Profit Accounts</strong>.</p>
                    </li>
                    <li>
                        <p>Leave <strong>Code Prefix</strong> blank unless
                        the new account numbers collide with your existing
                        chart.</p>
                    </li>
                    <li>
                        <p>Keep <strong>Skip Codes That Already Exist</strong>
                        ticked.</p>
                    </li>
                    <li>
                        <p>Click <strong>Add Accounts</strong>.</p>
                    </li>
                </ol>

                <div class="oe-diagram">
                    <div class="oe-mock-bar">
                        <span class="oe-mock-dots"><span /><span /><span /></span>
                        Add Non-Profit Accounts
                    </div>
                    <div class="oe-mock-body">
                        <p class="mb-2"><strong>Adds to your chart</strong></p>
                        <p>
                            <span class="oe-badge">Contribution</span>
                            <span class="oe-badge">Grant</span>
                            <span class="oe-badge">Special Events</span>
                            <span class="oe-badge">In-Kind</span>
                            <span class="oe-badge">Functional Expense</span>
                            <span class="oe-badge">Net Asset</span>
                        </p>
                        <p class="mb-0 text-muted">It only adds accounts - it
                        never changes or removes anything already in your
                        chart.</p>
                    </div>
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Illustration</span>
                        the account groups the wizard adds - your chart's
                        actual account numbers will differ.
                    </p>
                </div>

                <div class="oe-callout oe-callout-good">
                    <span class="oe-callout-icon"><i class="fa fa-refresh" /></span>
                    <div>
                        <span class="oe-callout-label">Safe to re-run</span>
                        <p>If you're not sure whether it ran, run it again.
                        Accounts that already exist are skipped.</p>
                    </div>
                </div>
                <div class="oe-diagram">
                    <img src="/nonprofit_elearning_finance/static/img/coa_wizard.png" alt="The Add Non-Profit Accounts dialog with a code prefix field and the skip-existing option ticked" class="img-fluid" />
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Screenshot</span>
                        the wizard, ready to add accounts.
                    </p>
                </div>
            </div>
        </field>
    </record>

    <record id="lesson_setup_options" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">Setting the fund-accounting options</field>
        <field name="slide_category">article</field>
        <field name="sequence">12</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <p>Go to <strong>Settings › Invoicing › Fund
                Accounting (Non-Profit)</strong>.</p>

                <ol class="oe-steps">
                    <li>
                        <p>Under <strong>Net Assets Released accounts</strong>,
                        click <strong>Detect from chart</strong> to fill the
                        two clearing accounts the restriction-release entry
                        uses.</p>
                    </li>
                    <li>
                        <p>Pick a default <strong>Program</strong> and
                        <strong>Function</strong> so you're not choosing
                        them on every release.</p>
                    </li>
                </ol>

                <div class="oe-callout oe-callout-warn">
                    <span class="oe-callout-icon"><i class="fa fa-exclamation-triangle" /></span>
                    <div>
                        <span class="oe-callout-label">Timing matters</span>
                        <p>Leave <strong>Require a Fund on income &amp;
                        expense</strong> off until you've entered your
                        opening balances and any historical entries. Only
                        then turn it on - once it's on, the system won't
                        let anyone post an income or expense line that isn't
                        100% assigned to a fund, which is exactly what you
                        want going forward, but would block your opening
                        entries if it's on too soon.</p>
                    </div>
                </div>
                <div class="oe-diagram">
                    <img src="/nonprofit_elearning_finance/static/img/fund_settings.png" alt="The Fund Accounting section of Settings, with the release accounts and Detect from chart" class="img-fluid" />
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Screenshot</span>
                        the Fund Accounting settings.
                    </p>
                </div>
            </div>
        </field>
    </record>

    <!-- ========== Section 2: Funds, programs & functions ========== -->
    <record id="section_funds" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">Funds, programs &amp; functions</field>
        <field name="is_category" eval="True" />
        <field name="sequence">20</field>
    </record>

    <record id="lesson_funds_questions" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">The three questions every transaction answers</field>
        <field name="slide_category">article</field>
        <field name="sequence">21</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <div class="oe-columns">
                    <div class="oe-column">
                        <h4><i class="fa fa-university" /> Fund</h4>
                        <p class="text-muted mb-1">Whose money is it?</p>
                        <p>
                            <span class="oe-badge">Unrestricted</span>
                            <span class="oe-badge">With Donor Restrictions - Purpose</span>
                            <span class="oe-badge">With Donor Restrictions - Time</span>
                            <span class="oe-badge">Perpetual / Endowment</span>
                        </p>
                    </div>
                    <div class="oe-column">
                        <h4><i class="fa fa-heart" /> Program</h4>
                        <p class="text-muted mb-1">Which mission activity?</p>
                        <p class="mb-0">A food pantry, an after-school club,
                        a clinic day. Add one per real activity.</p>
                    </div>
                </div>

                <div class="oe-diagram">
                    <div class="oe-flow">
                        <div class="oe-flow-step">Fund</div>
                        <span class="oe-flow-arrow">+</span>
                        <div class="oe-flow-step">Program</div>
                        <span class="oe-flow-arrow">+</span>
                        <div class="oe-flow-step">Function</div>
                        <span class="oe-flow-arrow"><i class="fa fa-long-arrow-right" /></span>
                        <div class="oe-flow-step">
                            <span class="oe-flow-step-icon"><i class="fa fa-sitemap" /></span>
                            Analytic Distribution
                        </div>
                    </div>
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Illustration</span>
                        the three questions every transaction answers, all
                        set on the same field.
                    </p>
                </div>

                <p><strong>Function</strong> - what kind of work? The three
                Form 990 columns: Program Services, Management &amp;
                General, Fundraising. Every expense is one of these.</p>

                <div class="oe-callout">
                    <span class="oe-callout-icon"><i class="fa fa-sitemap" /></span>
                    <div>
                        <span class="oe-callout-label">One field, every report</span>
                        <p>You answer all three in the same place: the
                        <strong>Analytic Distribution</strong> field on an
                        invoice, bill, or journal-entry line. Set the fund
                        to 100% (split across two if a gift is genuinely
                        shared), then add the Program and Function the same
                        way. That one field feeds every report later in
                        this course.</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

    <!-- ============ Section 3: Recording and releasing ============ -->
    <record id="section_recording" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">Recording and releasing</field>
        <field name="is_category" eval="True" />
        <field name="sequence">30</field>
    </record>

    <record id="lesson_vendor_bill" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">A vendor bill</field>
        <field name="slide_category">article</field>
        <field name="sequence">31</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <p>Enter the bill as normal under <strong>Invoicing ›
                Vendors › Bills</strong>. On each expense line, set
                <strong>Analytic Distribution</strong>: the Fund it's paid
                from, the Program it serves, and the Function.</p>

                <div class="oe-diagram">
                    <div class="oe-mock-bar">
                        <span class="oe-mock-dots"><span /><span /><span /></span>
                        Vendor Bill - Line 1
                    </div>
                    <div class="oe-mock-body">
                        <p class="mb-2"><strong>Analytic Distribution</strong></p>
                        <p>
                            <span class="oe-badge oe-badge-accent">Program Services 70%</span>
                            <span class="oe-badge oe-badge-warn">Management &amp; General 30%</span>
                        </p>
                        <p class="mb-0 text-muted">Split a line whenever the
                        expense is genuinely shared across more than one
                        Function.</p>
                    </div>
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Illustration</span>
                        splitting one bill line 70/30 across two Functions -
                        your own splits will vary by bill.
                    </p>
                </div>
            </div>
        </field>
    </record>

    <record id="lesson_release" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">Releasing restricted funds</field>
        <field name="slide_category">article</field>
        <field name="sequence">32</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <p>When a donor's purpose has been met or a time restriction
                has passed, you move that money from the restricted class
                to unrestricted - with the release wizard, not a
                hand-written journal entry.</p>

                <ol class="oe-steps">
                    <li>
                        <p>Open <strong>Invoicing › Non-Profit ›
                        Restriction Releases › New</strong>.</p>
                    </li>
                    <li>
                        <p>Set <strong>Released From</strong> (the
                        restricted fund) and <strong>Released To</strong>
                        (normally Unrestricted).</p>
                    </li>
                    <li>
                        <p>Enter the amount and date.</p>
                    </li>
                    <li>
                        <p>Click <strong>Post</strong>.</p>
                    </li>
                </ol>

                <div class="oe-diagram">
                    <div class="oe-flow">
                        <div class="oe-flow-step">
                            <span class="oe-badge oe-badge-warn">Restricted Fund</span>
                        </div>
                        <span class="oe-flow-arrow"><i class="fa fa-long-arrow-right" /></span>
                        <div class="oe-flow-step">
                            <span class="oe-flow-step-icon"><i class="fa fa-exchange" /></span>
                            Restriction Release
                        </div>
                        <span class="oe-flow-arrow"><i class="fa fa-long-arrow-right" /></span>
                        <div class="oe-flow-step">
                            <span class="oe-badge oe-badge-good">Unrestricted</span>
                        </div>
                    </div>
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Illustration</span>
                        posting creates one balanced entry between the two
                        Net Assets Released accounts - a reduction on one
                        side, an equal increase on the other, zero to the
                        bottom line.
                    </p>
                </div>

                <div class="oe-callout oe-callout-warn">
                    <span class="oe-callout-icon"><i class="fa fa-undo" /></span>
                    <div>
                        <span class="oe-callout-label">Made a mistake?</span>
                        <p>Open the release and click <strong>Cancel</strong>
                        to reverse it - never delete the entry by hand.</p>
                    </div>
                </div>

                <div class="oe-callout oe-callout-good">
                    <span class="oe-callout-icon"><i class="fa fa-line-chart" /></span>
                    <div>
                        <span class="oe-callout-label">Check your work any time</span>
                        <p><strong>Invoicing › Non-Profit ›
                        Net-Asset Roll-Forward</strong> shows opening
                        balance, revenue, expense, releases in and out, and
                        closing balance, per fund, for any date range.</p>
                    </div>
                </div>
                <div class="oe-diagram">
                    <img src="/nonprofit_elearning_finance/static/img/release_form.png" alt="A new restriction release form with Released From, Released To, amount and date" class="img-fluid" />
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Screenshot</span>
                        a new restriction release.
                    </p>
                </div>
            </div>
        </field>
    </record>

    <!-- ============= Section 4: Board & IRS reporting ============= -->
    <record id="section_reporting" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">Board &amp; IRS reporting</field>
        <field name="is_category" eval="True" />
        <field name="sequence">40</field>
    </record>

    <record id="lesson_board_reports" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">Statement of Activities &amp; Financial Position</field>
        <field name="slide_category">article</field>
        <field name="sequence">41</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <p>Because every transaction already carries its fund,
                program, and function, the board reports come out without
                extra bookkeeping. Find them under <strong>Invoicing › Reporting › MIS Reporting › MIS Reports</strong>.</p>

                <div class="oe-columns">
                    <div class="oe-column">
                        <h4><i class="fa fa-bar-chart" /> Statement of Activities</h4>
                        <p class="mb-0">Revenue by source, expense by
                        function, change in net assets.</p>
                    </div>
                    <div class="oe-column">
                        <h4><i class="fa fa-balance-scale" /> Statement of Financial Position</h4>
                        <p class="mb-0">Assets, liabilities, and net assets
                        split into with/without donor restrictions.</p>
                    </div>
                </div>

                <div class="oe-callout">
                    <span class="oe-callout-icon"><i class="fa fa-filter" /></span>
                    <div>
                        <span class="oe-callout-label">Breaking it out by fund</span>
                        <p>Add fund-filtered periods to a report instance to
                        show either statement broken out by fund.</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

    <record id="lesson_990" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">The Form 990 functional-expense grid</field>
        <field name="slide_category">article</field>
        <field name="sequence">42</field>
        <field name="html_content" type="html">
            <div class="oe-course-content">
                <p><strong>Invoicing › Reporting › Non-Profit
                › Functional Expenses (990 Part IX)</strong> gives your 990 preparer a
                grid of every natural expense account against the three
                Function columns - built straight from the Function you set
                on every expense line.</p>

                <div class="oe-diagram">
                    <div class="oe-mock-bar">
                        <span class="oe-mock-dots"><span /><span /><span /></span>
                        Functional Expenses
                    </div>
                    <div class="oe-mock-body">
                        <p class="mb-2"><strong>Every natural account, against:</strong></p>
                        <p>
                            <span class="oe-badge oe-badge-accent">Program Services</span>
                            <span class="oe-badge oe-badge-warn">Management &amp; General</span>
                            <span class="oe-badge">Fundraising</span>
                        </p>
                        <p class="mb-0 text-muted">Ready for the 990 preparer
                        exactly as it stands - no reclassifying by hand.</p>
                    </div>
                    <p class="oe-diagram-caption">
                        <span class="oe-diagram-caption-tag">Illustration</span>
                        the shape of the functional-expense grid - your
                        actual account list will be longer.
                    </p>
                </div>
            </div>
        </field>
    </record>

    <!-- ========================= Quiz ========================= -->
    <record id="slide_quiz" model="slide.slide">
        <field name="channel_id" ref="channel_finance" />
        <field name="name">Check your understanding</field>
        <field name="slide_category">quiz</field>
        <field name="sequence">90</field>
    </record>

    <record id="quiz_q1" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">1</field>
        <field name="question">A donor gives $5,000 that must be spent on the after-school club by June. Which Fund do you use?</field>
    </record>
    <record id="quiz_q1_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">1</field>
        <field name="text_value">Unrestricted</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q1_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">2</field>
        <field name="text_value">With Donor Restrictions - Time</field>
        <field name="is_correct" eval="True" />
        <field name="comment">A June deadline is a time condition, not a purpose one - though this gift also names the after-school club as its Program.</field>
    </record>
    <record id="quiz_q1_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">3</field>
        <field name="text_value">Perpetual / Endowment</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q1_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q1" />
        <field name="sequence">4</field>
        <field name="text_value">It doesn't need a fund, only a Program</field>
        <field name="is_correct" eval="False" />
    </record>

    <record id="quiz_q2" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">2</field>
        <field name="question">Where do you set the Fund, Program, and Function on a transaction?</field>
    </record>
    <record id="quiz_q2_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">1</field>
        <field name="text_value">The Analytic Distribution field on the line</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q2_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">2</field>
        <field name="text_value">The customer/vendor's contact record</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q2_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">3</field>
        <field name="text_value">A separate spreadsheet you keep alongside Odoo</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q2_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q2" />
        <field name="sequence">4</field>
        <field name="text_value">The journal used to post the entry</field>
        <field name="is_correct" eval="False" />
    </record>

    <record id="quiz_q3" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">3</field>
        <field name="question">How do you move money from a restricted fund to unrestricted once the donor's condition is met?</field>
    </record>
    <record id="quiz_q3_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">1</field>
        <field name="text_value">Write a journal entry by hand between the two funds</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q3_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">2</field>
        <field name="text_value">Edit the original donation record's fund field</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q3_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">3</field>
        <field name="text_value">The Restriction Release wizard</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q3_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q3" />
        <field name="sequence">4</field>
        <field name="text_value">Delete and re-enter the original gift</field>
        <field name="is_correct" eval="False" />
    </record>

    <record id="quiz_q4" model="slide.question">
        <field name="slide_id" ref="slide_quiz" />
        <field name="sequence">4</field>
        <field name="question">Which report gives the 990 preparer expenses by Program Services / Management &amp; General / Fundraising?</field>
    </record>
    <record id="quiz_q4_a1" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">1</field>
        <field name="text_value">The Net-Asset Roll-Forward</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q4_a2" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">2</field>
        <field name="text_value">The Functional Expenses grid</field>
        <field name="is_correct" eval="True" />
    </record>
    <record id="quiz_q4_a3" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">3</field>
        <field name="text_value">The Statement of Financial Position</field>
        <field name="is_correct" eval="False" />
    </record>
    <record id="quiz_q4_a4" model="slide.answer">
        <field name="question_id" ref="quiz_q4" />
        <field name="sequence">4</field>
        <field name="text_value">The donor's tax receipt</field>
        <field name="is_correct" eval="False" />
    </record>

</odoo>
