<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- A dedicated Entertainment privilege/tier - separate from the
         blanket event.group_event_user/manager every event-domain
         module used to share. Manager implies User implies Viewer. -->
    <record id="res_groups_privilege_entertainment" model="res.groups.privilege">
        <field name="name">Entertainment</field>
        <field name="category_id" ref="base.module_category_marketing" />
    </record>
    <record id="group_entertainment_viewer" model="res.groups">
        <field name="name">Entertainment Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_entertainment" />
    </record>
    <record id="group_entertainment_user" model="res.groups">
        <field name="name">Entertainment User</field>
        <field name="privilege_id" ref="res_groups_privilege_entertainment" />
        <field name="implied_ids" eval="[(4, ref('group_entertainment_viewer'))]" />
    </record>
    <record id="group_entertainment_manager" model="res.groups">
        <field name="name">Entertainment Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_entertainment" />
        <field name="implied_ids" eval="[(4, ref('group_entertainment_user'))]" />
    </record>
</odoo>
