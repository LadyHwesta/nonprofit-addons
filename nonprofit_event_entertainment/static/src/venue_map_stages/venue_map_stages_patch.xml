<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-inherit="nonprofit_event_venue.VendorMapAction" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('text-muted')][hasclass('small')]" position="inside">
            <span class="ms-3">
                <span class="o_nonprofit_stage_pin_inner d-inline-block" /> Stage
            </span>
        </xpath>
        <xpath expr="//div[hasclass('p-2')][hasclass('border-bottom')]" position="after">
            <div t-if="state.event" class="p-2 border-bottom bg-light">
                <button type="button" class="btn btn-sm btn-outline-secondary"
                        t-on-click="() => this.toggleStagePlacementMode()">
                    <t t-esc="state.stagePlacementMode ? 'Done Placing Stages' : 'Place Stages'" />
                </button>
                <div t-if="state.stagePlacementMode" class="mt-2 small">
                    <span t-if="!unplacedStages.length" class="text-muted">
                        Every stage already has a position.
                    </span>
                    <t t-else="">
                        <span class="text-muted">Click a stage, then click the map:</span>
                        <button t-foreach="unplacedStages" t-as="stage" t-key="stage.id"
                                type="button"
                                t-attf-class="btn btn-sm ms-1 {{ state.placingStageId === stage.id ? 'btn-primary' : 'btn-outline-primary' }}"
                                t-on-click="() => this.armStage(stage.id)">
                            <t t-esc="stage.name" />
                        </button>
                    </t>
                </div>
            </div>
        </xpath>
    </t>

</templates>
