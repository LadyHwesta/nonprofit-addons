<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="event_stage_view_list" model="ir.ui.view">
        <field name="model">event.stage</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="event_id" optional="show" />
                <field name="name" />
                <field name="start_time" />
                <field name="line_count" optional="show" string="Items" />
                <field name="latitude" optional="hide" groups="base.group_no_one" />
                <field name="longitude" optional="hide" groups="base.group_no_one" />
            </list>
        </field>
    </record>

    <record id="event_stage_view_form" model="ir.ui.view">
        <field name="model">event.stage</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Main Stage" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id" />
                            <field name="start_time" />
                        </group>
                        <group>
                            <field name="latitude" />
                            <field name="longitude" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Run of Show" name="run_of_show">
                            <button name="%(action_report_run_of_show)d" type="action"
                                    string="Print Run of Show" class="btn-link mb-2" />
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle" />
                                    <field name="line_type" />
                                    <field name="performer_id"
                                           invisible="line_type != 'performance'"
                                           required="line_type == 'performance'" />
                                    <field name="title" />
                                    <field name="duration_minutes" />
                                    <field name="planned_start_override" optional="show" />
                                    <field name="computed_start" readonly="1" />
                                    <field name="computed_end" readonly="1" optional="hide" />
                                    <field name="booking_state" widget="badge"
                                           invisible="line_type != 'performance'"
                                           decoration-muted="booking_state == 'invited'"
                                           decoration-success="booking_state == 'confirmed'"
                                           decoration-danger="booking_state in ('declined', 'cancelled')" />
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_event_stage" model="ir.actions.act_window">
        <field name="name">Stages</field>
        <field name="res_model">event.stage</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_event_id': active_id}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a stage</p>
            <p>Each stage gets its own independent, ordered run of show,
               starting from its own start time.</p>
        </field>
    </record>

</odoo>
