<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">

    <record id="ir_cron_flag_permit_deadlines" model="ir.cron">
        <field name="name">Event Logistics: flag permit deadlines</field>
        <field name="model_id" ref="model_event_permit" />
        <field name="state">code</field>
        <field name="code">model._cron_flag_permit_deadlines()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_event_readiness_check" model="ir.cron">
        <field name="name">Event Logistics: readiness check</field>
        <field name="model_id" ref="event.model_event_event" />
        <field name="state">code</field>
        <field name="code">model._cron_event_readiness_check()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True" />
    </record>

</odoo>
