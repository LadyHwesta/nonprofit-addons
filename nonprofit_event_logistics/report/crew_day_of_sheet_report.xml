<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="action_report_crew_day_of_sheet" model="ir.actions.report">
        <field name="name">Crew &amp; Facilities Day-Of Sheet</field>
        <field name="model">event.event</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">nonprofit_event_logistics.crew_day_of_sheet</field>
        <field name="report_file">nonprofit_event_logistics.crew_day_of_sheet</field>
        <field name="print_report_name">'Crew and Facilities Day-Of Sheet - %s' % object.name</field>
        <field name="binding_model_id" ref="event.model_event_event" />
        <field name="binding_type">report</field>
    </record>

    <template id="crew_day_of_sheet">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Crew &amp; Facilities Day-Of Sheet</h2>
                        <h4 class="text-muted"><span t-field="o.name" /></h4>

                        <h5 class="mt-4">Crew Bookings</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Vendor / Crew</th>
                                    <th>Service</th>
                                    <th>Load In</th>
                                    <th>Load Out</th>
                                    <th>Day-Of Contact</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.crew_booking_ids.sorted('load_in')"
                                    t-as="booking">
                                    <td><span t-field="booking.partner_id.display_name" /></td>
                                    <td><span t-esc="dict(booking._fields['service_type'].selection).get(booking.service_type)" /></td>
                                    <td><span t-field="booking.load_in" /></td>
                                    <td><span t-field="booking.load_out" /></td>
                                    <td>
                                        <span t-esc="booking.day_of_contact_name or ''" />
                                        <span t-if="booking.day_of_contact_phone">
                                            — <span t-esc="booking.day_of_contact_phone" />
                                        </span>
                                    </td>
                                    <td><span t-esc="dict(booking._fields['state'].selection).get(booking.state)" /></td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-if="not o.crew_booking_ids" class="text-muted">
                            No crew bookings added yet.
                        </p>

                        <h5 class="mt-4">Facilities</h5>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Facility</th>
                                    <th>Type</th>
                                    <th>Qty</th>
                                    <th>Serviced By</th>
                                    <th>Servicing Schedule</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="o.facility_ids" t-as="facility">
                                    <td><span t-field="facility.name" /></td>
                                    <td><span t-esc="dict(facility._fields['facility_type'].selection).get(facility.facility_type)" /></td>
                                    <td><span t-field="facility.quantity" /></td>
                                    <td><span t-esc="facility.crew_booking_id.partner_id.display_name or ''" /></td>
                                    <td><span t-esc="facility.servicing_schedule or ''" /></td>
                                </tr>
                            </tbody>
                        </table>
                        <p t-if="not o.facility_ids" class="text-muted">
                            No facilities added yet.
                        </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
