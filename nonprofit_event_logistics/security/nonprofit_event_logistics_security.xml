<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- A dedicated Logistics privilege/tier (permits, temp staff
         shifts/assignments, crew bookings, facilities) - separate from
         the blanket event.group_event_user/manager every event-domain
         module used to share. Manager implies User implies Viewer. -->
    <record id="res_groups_privilege_logistics" model="res.groups.privilege">
        <field name="name">Event Logistics</field>
        <field name="category_id" ref="base.module_category_marketing" />
    </record>
    <record id="group_logistics_viewer" model="res.groups">
        <field name="name">Logistics Viewer</field>
        <field name="privilege_id" ref="res_groups_privilege_logistics" />
    </record>
    <record id="group_logistics_user" model="res.groups">
        <field name="name">Logistics User</field>
        <field name="privilege_id" ref="res_groups_privilege_logistics" />
        <field name="implied_ids" eval="[(4, ref('group_logistics_viewer'))]" />
    </record>
    <record id="group_logistics_manager" model="res.groups">
        <field name="name">Logistics Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_logistics" />
        <field name="implied_ids" eval="[(4, ref('group_logistics_user'))]" />
    </record>
</odoo>
