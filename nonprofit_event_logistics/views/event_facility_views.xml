<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="event_facility_view_list" model="ir.ui.view">
        <field name="model">event.facility</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="event_id" optional="show" />
                <field name="name" />
                <field name="facility_type" />
                <field name="quantity" />
                <field name="crew_booking_id" optional="hide" />
                <field name="latitude" optional="hide" groups="base.group_no_one" />
                <field name="longitude" optional="hide" groups="base.group_no_one" />
            </list>
        </field>
    </record>

    <record id="event_facility_view_form" model="ir.ui.view">
        <field name="model">event.facility</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id" />
                            <field name="facility_type" />
                            <field name="quantity" />
                            <field name="crew_booking_id" />
                        </group>
                        <group>
                            <field name="latitude" />
                            <field name="longitude" />
                        </group>
                    </group>
                    <field name="servicing_schedule" placeholder="e.g. Pumped daily at 6am" />
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_event_facility" model="ir.actions.act_window">
        <field name="name">Facilities</field>
        <field name="res_model">event.facility</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'default_event_id': active_id}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add a facility</p>
            <p>Restrooms, hand-wash stations, first aid, water stations -
               drop a pin for each on the event's Vendor Map once added
               here.</p>
        </field>
    </record>

</odoo>
