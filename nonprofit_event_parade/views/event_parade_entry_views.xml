<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="event_parade_entry_view_list" model="ir.ui.view">
        <field name="model">event.parade.entry</field>
        <field name="arch" type="xml">
            <list default_order="staging_area_id, sequence">
                <field name="sequence" widget="handle" />
                <field name="entry_number" optional="show" />
                <field name="name" />
                <field name="org_name" optional="show" />
                <field name="entry_type" />
                <field name="participant_count" sum="Participants" />
                <field name="staging_area_id" />
                <field name="step_off_time" optional="show" />
                <field name="state" widget="badge"
                       decoration-info="state in ('submitted',)"
                       decoration-warning="state == 'approved'"
                       decoration-success="state == 'confirmed'"
                       decoration-danger="state in ('rejected', 'withdrawn')" />
            </list>
        </field>
    </record>

    <record id="event_parade_entry_view_form" model="ir.ui.view">
        <field name="model">event.parade.entry</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve"
                            class="btn-primary" invisible="state != 'submitted'" />
                    <button name="action_confirm" type="object"
                            string="Confirm for Lineup" class="btn-primary"
                            invisible="state != 'approved'" />
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state not in ('submitted', 'approved')" />
                    <button name="action_withdraw" type="object" string="Withdraw"
                            invisible="state in ('rejected', 'withdrawn')" />
                    <button name="action_reset_to_submitted" type="object"
                            string="Reset to Submitted"
                            invisible="state not in ('approved', 'rejected')" />
                    <field name="state" widget="statusbar"
                           statusbar_visible="submitted,approved,confirmed" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" /></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event_id" />
                            <field name="org_name" />
                            <field name="entry_type" />
                            <field name="waiver_accepted" />
                        </group>
                        <group>
                            <field name="partner_id" />
                            <field name="contact_name" />
                            <field name="contact_email" widget="email" />
                            <field name="contact_phone" widget="phone" />
                        </group>
                    </group>
                    <group string="Logistics">
                        <group>
                            <field name="participant_count" />
                            <field name="vehicle_count" />
                            <field name="linear_feet_needed" />
                            <field name="sound_amplification" />
                        </group>
                        <group>
                            <field name="staging_area_id" />
                            <field name="sequence" />
                            <field name="entry_number" />
                            <field name="step_off_time" />
                        </group>
                    </group>
                    <group>
                        <field name="special_requirements" />
                        <field name="rejection_reason"
                               invisible="state != 'rejected'" />
                        <field name="notes" />
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="event_parade_entry_view_search" model="ir.ui.view">
        <field name="model">event.parade.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="org_name" />
                <field name="event_id" />
                <filter string="Submitted" name="filter_submitted"
                        domain="[('state', '=', 'submitted')]" />
                <filter string="Confirmed" name="filter_confirmed"
                        domain="[('state', '=', 'confirmed')]" />
                <group>
                    <filter string="Event" name="group_by_event"
                            context="{'group_by': 'event_id'}" />
                    <filter string="Staging Area" name="group_by_staging_area"
                            context="{'group_by': 'staging_area_id'}" />
                    <filter string="Status" name="group_by_state"
                            context="{'group_by': 'state'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_event_parade_entry" model="ir.actions.act_window">
        <field name="name">Parade Entries</field>
        <field name="res_model">event.parade.entry</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No parade entries yet</p>
            <p>Entries appear here once a group applies through the public
               parade page, or add one by hand.</p>
        </field>
    </record>

</odoo>
