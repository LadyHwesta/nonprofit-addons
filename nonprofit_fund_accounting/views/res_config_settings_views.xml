<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.nonprofit.fund</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="analytic" position="after">
                <block title="Fund Accounting (Non-Profit)" id="nonprofit_fund"
                       groups="account.group_account_user">
                    <setting id="nonprofit_fund_required_setting"
                             string="Require a Fund on income &amp; expense"
                             help="Block posting a journal entry while an income
                                   or expense line is not assigned 100% to Fund
                                   analytic accounts.">
                        <field name="nonprofit_fund_required" />
                    </setting>
                    <setting id="nonprofit_fund_defaults_setting"
                             string="Default Program &amp; Function"
                             help="Pre-filled on a restriction release.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="nonprofit_default_program_id"
                                       class="col-lg-4 o_light_label" />
                                <field name="nonprofit_default_program_id" />
                            </div>
                            <div class="row">
                                <label for="nonprofit_default_function_id"
                                       class="col-lg-4 o_light_label" />
                                <field name="nonprofit_default_function_id" />
                            </div>
                        </div>
                    </setting>
                    <setting id="nonprofit_release_accounts_setting"
                             string="Net Assets Released accounts"
                             help="The two income clearing accounts used by the
                                   restriction-release entry. Auto-detected from
                                   the nonprofit_base chart.">
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="nonprofit_release_restricted_account_id"
                                       class="col-lg-4 o_light_label" />
                                <field name="nonprofit_release_restricted_account_id" />
                            </div>
                            <div class="row">
                                <label for="nonprofit_release_unrestricted_account_id"
                                       class="col-lg-4 o_light_label" />
                                <field name="nonprofit_release_unrestricted_account_id" />
                            </div>
                            <div class="row">
                                <button type="object"
                                        name="action_nonprofit_detect_release_accounts"
                                        string="Detect from chart"
                                        class="btn-link" icon="fa-refresh" />
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
