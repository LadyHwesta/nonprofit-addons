<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record id="stage_prospect" model="nonprofit.grant.stage">
            <field name="name">Prospect</field><field name="sequence">10</field>
        </record>
        <record id="stage_inquiry" model="nonprofit.grant.stage">
            <field name="name">Letter of Inquiry</field><field name="sequence">20</field>
        </record>
        <record id="stage_writing" model="nonprofit.grant.stage">
            <field name="name">Writing</field><field name="sequence">30</field>
        </record>
        <record id="stage_submitted" model="nonprofit.grant.stage">
            <field name="name">Submitted</field><field name="sequence">40</field>
        </record>
        <record id="stage_awarded" model="nonprofit.grant.stage">
            <field name="name">Awarded</field><field name="sequence">50</field>
            <field name="is_awarded" eval="True" />
        </record>
        <record id="stage_declined" model="nonprofit.grant.stage">
            <field name="name">Declined</field><field name="sequence">60</field>
            <field name="is_declined" eval="True" /><field name="fold" eval="True" />
        </record>
        <record id="stage_closed" model="nonprofit.grant.stage">
            <field name="name">Closed</field><field name="sequence">70</field>
            <field name="is_awarded" eval="True" /><field name="is_closed" eval="True" />
            <field name="fold" eval="True" />
        </record>
    </data>

    <!-- Grant funds sit under Fund > Grants, so the suite's fund reports and
         restriction releases see them as Funds. -->
    <record id="analytic_plan_fund_grants" model="account.analytic.plan">
        <field name="name">Grants</field>
        <field name="parent_id" ref="nonprofit_base.analytic_plan_fund" />
    </record>
</odoo>
