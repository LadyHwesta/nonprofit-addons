<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_groups_privilege_grants" model="res.groups.privilege">
        <field name="name">Grants</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="base.module_category_accounting" />
    </record>
    <record id="group_grant_viewer" model="res.groups">
        <field name="name">Viewer</field>
        <field name="sequence">5</field>
        <field name="privilege_id" ref="res_groups_privilege_grants" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="comment">Sees grants, their reports and payments; changes nothing.</field>
    </record>
    <record id="group_grant_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_grants" />
        <field name="implied_ids" eval="[(4, ref('group_grant_viewer'))]" />
        <field name="comment">Writes grants: pipeline, deadlines, reports and payment schedules.</field>
    </record>
    <record id="group_grant_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_grants" />
        <field name="implied_ids" eval="[(4, ref('group_grant_user'))]" />
        <field name="comment">Also deletes grants, sets up stages, and invoices funders.</field>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]" />
    </record>

    <record id="rule_grant_company" model="ir.rule">
        <field name="name">Grant: multi-company</field>
        <field name="model_id" ref="model_nonprofit_grant" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_grant_report_company" model="ir.rule">
        <field name="name">Grant report: multi-company</field>
        <field name="model_id" ref="model_nonprofit_grant_report" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_grant_payment_company" model="ir.rule">
        <field name="name">Grant payment: multi-company</field>
        <field name="model_id" ref="model_nonprofit_grant_payment" />
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
