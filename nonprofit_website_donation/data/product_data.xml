<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="product_online_donation" model="product.product">
        <field name="name">Online donation</field>
        <field name="type">service</field>
        <field name="donation_type">donation</field>
        <field name="tax_receipt_ok" eval="True"/>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0.0</field>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>
        <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
    </record>

    <record id="product_donor_covered_fees" model="product.product">
        <field name="name">Processing fees covered by donor</field>
        <field name="type">service</field>
        <field name="donation_type">donation</field>
        <field name="tax_receipt_ok" eval="True"/>
        <field name="sale_ok" eval="False"/>
        <field name="purchase_ok" eval="False"/>
        <field name="list_price">0.0</field>
        <field name="taxes_id" eval="[(5, 0, 0)]"/>
        <field name="supplier_taxes_id" eval="[(5, 0, 0)]"/>
    </record>

</odoo>
