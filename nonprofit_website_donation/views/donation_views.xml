<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="donation_form" model="ir.ui.view">
        <field name="name">donation.donation.form.website</field>
        <field name="model">donation.donation</field>
        <field name="inherit_id" ref="donation.donation_form"/>
        <field name="arch" type="xml">
            <field name="payment_ref" position="after">
                <field name="payment_transaction_id" invisible="not payment_transaction_id"/>
            </field>
        </field>
    </record>

</odoo>
