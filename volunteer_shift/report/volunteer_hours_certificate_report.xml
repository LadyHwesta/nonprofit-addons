<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="action_report_volunteer_hours_certificate" model="ir.actions.report">
        <field name="name">Volunteer Hours Certificate</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">volunteer_shift.hours_certificate</field>
        <field name="report_file">volunteer_shift.hours_certificate</field>
        <field name="print_report_name">
            'Volunteer Hours %s - %s' % (data.get('year', ''), object.name)
        </field>
    </record>

    <template id="hours_certificate">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lines" t-value="rows.get(o.id, [])" />
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2>Volunteer Service Certificate</h2>
                        <p class="mt-3">
                            This certifies that <strong><span t-field="o.name" /></strong>
                            volunteered <strong><span t-esc="'%.2f' % totals.get(o.id, 0.0)" /></strong>
                            hours with <span t-field="company.name" /> during
                            <strong><span t-esc="year" /></strong>.
                        </p>

                        <table class="table table-sm mt-4">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Program</th>
                                    <th>Event</th>
                                    <th>Role</th>
                                    <th class="text-end">Hours</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="lines" t-as="line">
                                    <td><span t-field="line.date" /></td>
                                    <td><span t-esc="line.event_type_id.name or ''" /></td>
                                    <td><span t-esc="line.event_id.name or ''" /></td>
                                    <td><span t-esc="line.role_id.name or ''" /></td>
                                    <td class="text-end"><span t-esc="'%.2f' % line.hours" /></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="4" class="text-end">Total hours</th>
                                    <th class="text-end"><span t-esc="'%.2f' % totals.get(o.id, 0.0)" /></th>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="row mt-5">
                            <div class="col-6">
                                <p>_____________________________</p>
                                <p>Volunteer Coordinator</p>
                                <p><span t-field="company.name" /></p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
