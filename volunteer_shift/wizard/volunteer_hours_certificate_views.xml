<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="volunteer_hours_certificate_wizard_form" model="ir.ui.view">
        <field name="name">volunteer.hours.certificate.wizard.form</field>
        <field name="model">volunteer.hours.certificate.wizard</field>
        <field name="arch" type="xml">
            <form string="Volunteer Hours Certificates">
                <sheet>
                    <group>
                        <field name="year" />
                        <field name="partner_ids" widget="many2many_tags"
                               placeholder="All volunteers with hours that year" />
                    </group>
                </sheet>
                <footer>
                    <button name="action_print" type="object" string="Print"
                            class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_volunteer_hours_certificate_wizard" model="ir.actions.act_window">
        <field name="name">Volunteer Hours Certificates</field>
        <field name="res_model">volunteer.hours.certificate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
